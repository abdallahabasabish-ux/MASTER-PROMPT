rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // فحص الصلاحية كأدمن
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // المستخدمين
    match /users/{userId} {
      allow read: if request.auth != null;
      // يمنع المستخدم من تعديل role أو uid
      allow create: if request.auth.uid == userId 
                    && !('role' in request.resource.data) 
                    && !('admin' in request.resource.data);
      allow update: if request.auth.uid == userId 
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys());
    }

    // بيانات الطلاب
    match /students/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // الدروس (عامة للقراءة، كتابة للأدمن)
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // سجلات التدقيق (Audit Logs) - قراءة وكتابة للأدمن فقط
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // نسمح للـ Cloud Functions فقط بالكتابة (عبر Admin SDK الذي يتجاوز Rules)
      // لا نسمح للعميل بالكتابة المباشرة لمنع التلاعب
      allow write: if false; 
    }
  }
}
