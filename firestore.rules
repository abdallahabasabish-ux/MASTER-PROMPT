rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // المدفوعات
    match /payments/{paymentId} {
      // الطالب يقرأ مدفوعاته، وينشئ مدفوعته. الأدمن يقرأ الجميع ويعدل الحالة.
      allow read: if isAdmin() || resource.data.studentId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if isAdmin(); // فقط الأدمن يغير الحالة من PENDING إلى APPROVED
    }

    // بيانات الطلاب (لتحديث الاشتراك)
    match /students/{userId} {
      allow read: if request.auth != null;
      // الأدمن يحدّث حالة الاشتراك، الطالب لا يملك صلاحية تعديلها بنفسه
      allow update: if isAdmin();
      allow create: if request.auth.uid == userId;
    }
    
    // الدروس (قراءة للجميع، كتابة للأدمن)
    match /lessons/{lessonId} {
      allow read: if true; 
      allow write: if isAdmin();
    }
  }
}
