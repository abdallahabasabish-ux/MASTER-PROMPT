rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==================== HELPERS ====================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isTeacher() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    
    function isStudent() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    
    function isOwnDocument(uid) {
      return request.auth.uid == uid;
    }
    
    function isVerifiedStudent() {
      return isStudent() &&
             get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'verified';
    }
    
    function isActiveSubscription() {
      return isStudent() &&
             get(/databases/$(database)/documents/subscriptions/$(request.auth.uid)).data.status == 'active';
    }
    
    function canAccessPremium() {
      return isVerifiedStudent() && isActiveSubscription();
    }
    
    // ==================== USERS COLLECTION ====================
    
    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwnDocument(uid) || isAdmin() || isTeacher());
      
      allow create: if isAuthenticated() && isOwnDocument(uid);
      
      allow update: if isAuthenticated() && isOwnDocument(uid) && 
                       !('role' in request.resource.data) &&
                       !('uid' in request.resource.data) &&
                       request.resource.data.keys().hasOnly(['displayName', 'verified', 'status', 'updatedAt', 'lastLogin']);
      
      allow delete: if isAdmin();
    }
    
    // ==================== STUDENTS COLLECTION ====================
    
    match /students/{uid} {
      allow read: if isAuthenticated() && (isOwnDocument(uid) || isAdmin() || isTeacher());
      
      allow create: if isAuthenticated() && isOwnDocument(uid);
      
      allow update: if isAuthenticated() && isOwnDocument(uid) && 
                       request.resource.data.keys().hasOnly(['firstName', 'lastName', 'grade', 'stage', 'governorate', 'guardian', 'status', 'updatedAt']);
      
      allow delete: if isAdmin();
    }
    
    // ==================== GUARDIANS COLLECTION ====================
    
    match /guardians/{phone} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher() || 
                    resource.data.students.hasAny([request.auth.uid]));
      
      allow create: if isAuthenticated() && isStudent() && 
                      request.resource.data.students.hasAny([request.auth.uid]);
      
      allow update: if isAuthenticated() && isAdmin();
      
      allow delete: if isAdmin();
    }
    
    // ==================== LESSONS COLLECTION ====================
    
    match /lessons/{lessonId} {
      allow read: if isAuthenticated() && isVerifiedStudent();
      
      allow create: if isAdmin() || isTeacher();
      
      allow update: if isAdmin() || isTeacher();
      
      allow delete: if isAdmin();
    }
    
    // ==================== EXAMS COLLECTION ====================
    
    match /exams/{examId} {
      allow read: if isAuthenticated() && isVerifiedStudent() && 
                    resource.data.isPublished == true;
      
      allow create: if isAdmin() || isTeacher();
      
      allow update: if isAdmin() || isTeacher();
      
      allow delete: if isAdmin();
    }
    
    // ==================== SUBMISSIONS COLLECTION ====================
    
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && 
                    (isOwnDocument(resource.data.studentId) || isAdmin() || isTeacher());
      
      allow create: if isAuthenticated() && isStudent() && 
                      isOwnDocument(request.resource.data.studentId) && 
                      request.resource.data.status == 'submitted' &&
                      !('autoScore' in request.resource.data) &&
                      !('essayScores' in request.resource.data) &&
                      !('totalScore' in request.resource.data);
      
      allow update: if isAuthenticated() && 
                      (isStudent() && isOwnDocument(resource.data.studentId) && 
                        resource.data.status == 'pending' &&
                        !('autoScore' in request.resource.data) &&
                        !('essayScores' in request.resource.data) &&
                        !('totalScore' in request.resource.data)) ||
                      (isTeacher() && resource.data.status in ['submitted', 'auto_graded', 'pending_review']) ||
                      isAdmin();
      
      allow delete: if isAdmin();
    }
    
    // ==================== PROGRESS COLLECTION ====================
    
    match /progress/{progressId} {
      allow read: if isAuthenticated() && 
                    (isOwnDocument(resource.data.studentId) || isAdmin() || isTeacher());
      
      allow create: if isAuthenticated() && isStudent() && 
                      isOwnDocument(request.resource.data.studentId);
      
      allow update: if isAuthenticated() && isStudent() && 
                      isOwnDocument(resource.data.studentId) &&
                      request.resource.data.keys().hasOnly(['videoProgress', 'pdfOpened', 'examStarted', 'examSubmitted', 'examScore', 'completed', 'lastAccessed', 'updatedAt']);
      
      allow delete: if isAdmin();
    }
    
    // ==================== SUBSCRIPTIONS COLLECTION ====================
    
    match /subscriptions/{studentId} {
      allow read: if isAuthenticated() && (isOwnDocument(studentId) || isAdmin());
      
      allow create: if isAuthenticated() && isStudent() && isOwnDocument(studentId);
      
      allow update: if isAuthenticated() && isAdmin() && 
                      request.resource.data.keys().hasOnly(['status', 'endDate', 'updatedAt']);
      
      allow delete: if isAdmin();
    }
    
    // ==================== PAYMENTS COLLECTION ====================
    
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && 
                    (isOwnDocument(resource.data.studentId) || isAdmin());
      
      allow create: if isAuthenticated() && isStudent() && 
                      isOwnDocument(request.resource.data.studentId);
      
      allow update: if isAuthenticated() && isAdmin() && 
                      request.resource.data.keys().hasOnly(['status', 'transactionId', 'updatedAt']);
      
      allow delete: if isAdmin();
    }
    
    // ==================== NOTIFICATIONS COLLECTION ====================
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwnDocument(resource.data.userId);
      
      allow create: if isAuthenticated() && isOwnDocument(request.resource.data.userId);
      
      allow update: if isAuthenticated() && isOwnDocument(resource.data.userId) &&
                      request.resource.data.keys().hasOnly(['read', 'updatedAt']);
      
      allow delete: if isAuthenticated() && isOwnDocument(resource.data.userId);
    }
    
    // ==================== SETTINGS COLLECTION ====================
    
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      
      allow write: if isAdmin();
    }
  }
}
