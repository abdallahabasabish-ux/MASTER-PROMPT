generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  student Student?
  teacher Teacher?
  notifications Notification[]
  auditLogs     AuditLog[]
  payments      Payment[]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Student {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  stageId            String?
  gradeId            String?
  termId             String?
  parentPhone        String?
  subscriptionStatus SubscriptionStatus @default(PENDING)
  subscriptionEnd    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stage Stage? @relation(fields: [stageId], references: [id])
  grade Grade? @relation(fields: [gradeId], references: [id])
  term  Term?  @relation(fields: [termId], references: [id])

  submissions  Submission[]
  examAttempts ExamAttempt[]
  progress     Progress[]
  results      Result[]
  payments     Payment[]
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
  SUSPENDED
}

model Teacher {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  bio        String?
  experience String?
  photoUrl   String?
  status     TeacherStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons    Lesson[]
  assignments Assignment[]
  exams      Exam[]
  questions  Question[]
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// باقي النماذج (Stage, Grade, Term, Subject, Unit, Lesson, ...) ستضاف في Phase 2
// لكننا نضيف الأساسيات لتشغيل المصادقة.

model Stage {
  id      String   @id @default(cuid())
  name    String
  order   Int
  grades  Grade[]
  students Student[]
}

model Grade {
  id      String   @id @default(cuid())
  name    String
  order   Int
  stage   Stage?   @relation(fields: [stageId], references: [id])
  stageId String?
  students Student[]
  terms    Term[]
}

model Term {
  id      String   @id @default(cuid())
  name    String
  order   Int
  grade   Grade?   @relation(fields: [gradeId], references: [id])
  gradeId String?
  students Student[]
}

// نماذج الإشعارات والسجلات
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())
}
// ... النماذج السابقة (User, Student, Teacher, Stage, Grade, Term)

model Subject {
  id        String   @id @default(cuid())
  name      String   // مثلاً: العلوم
  code      String?  // اختصار
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  gradeId   String?
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  order     Int
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  gradeId   String?
  term      Term?    @relation(fields: [termId], references: [id])
  termId    String?
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String      @id @default(cuid())
  title       String
  description String?     // وصف قصير
  coverImage  String?     // رابط صورة الغلاف
  status      LessonStatus @default(DRAFT)
  order       Int         // ترتيب الدرس داخل الوحدة
  unit        Unit        @relation(fields: [unitId], references: [id])
  unitId      String
  teacher     Teacher     @relation(fields: [teacherId], references: [id])
  teacherId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?   // تاريخ النشر

  content     LessonContent? // محتوى نصي غني (one-to-one)
  videos      LessonVideo[]
  files       LessonFile[]
  assignments Assignment[]
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LessonContent {
  id        String   @id @default(cuid())
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  lessonId  String   @unique
  content   String   // HTML أو JSON بعد التنظيف
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LessonVideo {
  id        String   @id @default(cuid())
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  lessonId  String
  provider  VideoProvider @default(YOUTUBE)
  url       String   // رابط الفيديو
  isMain    Boolean  @default(false) // فيديو رئيسي
  createdAt DateTime @default(now())
}

enum VideoProvider {
  YOUTUBE
  EXTERNAL
  CLOUDFLARE_STREAM
  S3
}

model LessonFile {
  id             String   @id @default(cuid())
  lesson         Lesson   @relation(fields: [lessonId], references: [id])
  lessonId       String
  fileName       String
  fileSize       Int      // بالبايت
  filePath       String   // مسار التخزين (أو URL)
  allowDownload  Boolean  @default(false)
  uploadedAt     DateTime @default(now())
}
