generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  student Student?
  teacher Teacher?
  notifications Notification[]
  auditLogs     AuditLog[]
  payments      Payment[]
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model Student {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id])
  userId             String   @unique
  stageId            String?
  gradeId            String?
  termId             String?
  parentPhone        String?
  subscriptionStatus SubscriptionStatus @default(PENDING)
  subscriptionEnd    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stage Stage? @relation(fields: [stageId], references: [id])
  grade Grade? @relation(fields: [gradeId], references: [id])
  term  Term?  @relation(fields: [termId], references: [id])

  submissions  Submission[]
  examAttempts ExamAttempt[]
  progress     Progress[]
  results      Result[]
  payments     Payment[]
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  EXPIRED
  CANCELLED
  SUSPENDED
}

model Teacher {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @unique
  bio        String?
  experience String?
  photoUrl   String?
  status     TeacherStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons    Lesson[]
  assignments Assignment[]
  exams      Exam[]
  questions  Question[]
}

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// باقي النماذج (Stage, Grade, Term, Subject, Unit, Lesson, ...) ستضاف في Phase 2
// لكننا نضيف الأساسيات لتشغيل المصادقة.

model Stage {
  id      String   @id @default(cuid())
  name    String
  order   Int
  grades  Grade[]
  students Student[]
}

model Grade {
  id      String   @id @default(cuid())
  name    String
  order   Int
  stage   Stage?   @relation(fields: [stageId], references: [id])
  stageId String?
  students Student[]
  terms    Term[]
}

model Term {
  id      String   @id @default(cuid())
  name    String
  order   Int
  grade   Grade?   @relation(fields: [gradeId], references: [id])
  gradeId String?
  students Student[]
}

// نماذج الإشعارات والسجلات
model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())
}
// ... النماذج السابقة (User, Student, Teacher, Stage, Grade, Term)

model Subject {
  id        String   @id @default(cuid())
  name      String   // مثلاً: العلوم
  code      String?  // اختصار
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  gradeId   String?
  units     Unit[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  order     Int
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  gradeId   String?
  term      Term?    @relation(fields: [termId], references: [id])
  termId    String?
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String      @id @default(cuid())
  title       String
  description String?     // وصف قصير
  coverImage  String?     // رابط صورة الغلاف
  status      LessonStatus @default(DRAFT)
  order       Int         // ترتيب الدرس داخل الوحدة
  unit        Unit        @relation(fields: [unitId], references: [id])
  unitId      String
  teacher     Teacher     @relation(fields: [teacherId], references: [id])
  teacherId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?   // تاريخ النشر

  content     LessonContent? // محتوى نصي غني (one-to-one)
  videos      LessonVideo[]
  files       LessonFile[]
  assignments Assignment[]
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model LessonContent {
  id        String   @id @default(cuid())
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  lessonId  String   @unique
  content   String   // HTML أو JSON بعد التنظيف
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LessonVideo {
  id        String   @id @default(cuid())
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  lessonId  String
  provider  VideoProvider @default(YOUTUBE)
  url       String   // رابط الفيديو
  isMain    Boolean  @default(false) // فيديو رئيسي
  createdAt DateTime @default(now())
}

enum VideoProvider {
  YOUTUBE
  EXTERNAL
  CLOUDFLARE_STREAM
  S3
}

model LessonFile {
  id             String   @id @default(cuid())
  lesson         Lesson   @relation(fields: [lessonId], references: [id])
  lessonId       String
  fileName       String
  fileSize       Int      // بالبايت
  filePath       String   // مسار التخزين (أو URL)
  allowDownload  Boolean  @default(false)
  uploadedAt     DateTime @default(now())
}
// ========== بنك الأسئلة ==========
model Question {
  id           String            @id @default(cuid())
  type         QuestionType      @default(MULTIPLE_CHOICE)
  difficulty   Difficulty        @default(MEDIUM)
  questionText String            @db.Text
  marks        Float             @default(1)
  // التصنيفات
  stageId      String?
  gradeId      String?
  termId       String?
  unitId       String?
  lessonId     String?
  // المنشئ
  teacher      Teacher           @relation(fields: [teacherId], references: [id])
  teacherId    String
  // العلاقات
  stage        Stage?            @relation(fields: [stageId], references: [id])
  grade        Grade?            @relation(fields: [gradeId], references: [id])
  term         Term?             @relation(fields: [termId], references: [id])
  unit         Unit?             @relation(fields: [unitId], references: [id])
  lesson       Lesson?           @relation(fields: [lessonId], references: [id])
  // خيارات (للموضوعي)
  options      QuestionOption[]
  // الربط بالواجبات والامتحانات
  assignmentQuestions AssignmentQuestion[]
  examQuestions       ExamQuestion[]
  // إجابات الطلاب
  answers      Answer[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  MULTIPLE_SELECT
  FILL_BLANK
  ESSAY
  ORDERING
  MATCHING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model QuestionOption {
  id         String   @id @default(cuid())
  question   Question @relation(fields: [questionId], references: [id])
  questionId String
  optionText String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int
}

// ========== الواجبات ==========
model Assignment {
  id                String     @id @default(cuid())
  title             String
  description       String?    @db.Text
  lesson            Lesson     @relation(fields: [lessonId], references: [id])
  lessonId          String
  durationMinutes   Int        @default(30)
  attemptsAllowed   Int        @default(1)
  startDate         DateTime?
  endDate           DateTime?
  totalMarks        Float      @default(10)
  status            AssignmentStatus @default(DRAFT)
  createdBy         Teacher    @relation(fields: [teacherId], references: [id])
  teacherId         String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  questions         AssignmentQuestion[]
  submissions       Submission[]
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AssignmentQuestion {
  id             String     @id @default(cuid())
  assignment     Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId   String
  question       Question   @relation(fields: [questionId], references: [id])
  questionId     String
  order          Int
}

// ========== محاولات الطالب ==========
model Submission {
  id               String           @id @default(cuid())
  student          Student          @relation(fields: [studentId], references: [id])
  studentId        String
  assignment       Assignment       @relation(fields: [assignmentId], references: [id])
  assignmentId     String
  attemptNumber    Int              @default(1)
  startedAt        DateTime         @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int?             // وقت الحل بالثواني
  status           SubmissionStatus @default(IN_PROGRESS)
  marksObtained    Float?           // الدرجة النهائية (بعد التصحيح الكامل)
  gradedBy         Teacher?         @relation(fields: [gradedById], references: [id])
  gradedById       String?

  answers          Answer[]
  result           Result?          // النتيجة النهائية (one-to-one)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED_PARTIAL
  COMPLETED
}

model Answer {
  id           String     @id @default(cuid())
  submission   Submission @relation(fields: [submissionId], references: [id])
  submissionId String
  question     Question   @relation(fields: [questionId], references: [id])
  questionId   String
  // الإجابة: نص (للمقالي) أو JSON (للخيارات أو الترتيب)
  answerText   String?    @db.Text
  answerJson   Json?      // لتخزين مصفوفة من IDs أو ترتيب
  isCorrect    Boolean?   // للأسئلة الموضوعية (محسوبة آلياً)
  marksAwarded Float?     // الدرجة الممنوحة (يدوياً أو آلياً)
  reviewedBy   Teacher?   @relation(fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
}

// ========== النتائج ==========
model Result {
  id               String   @id @default(cuid())
  student          Student  @relation(fields: [studentId], references: [id])
  studentId        String
  submission       Submission? @relation(fields: [submissionId], references: [id])
  submissionId     String?   @unique
  // أو يمكن أن يكون مرجعاً لـ Exam
  // referenceType  String   // ASSIGNMENT | EXAM
  // referenceId    String
  totalMarks       Float
  obtainedMarks    Float
  percentage       Float
  correctCount     Int
  wrongCount       Int
  unattemptedCount Int
  timeTakenSeconds Int?
  attemptNumber    Int
  status           ResultStatus @default(PENDING)
  gradedAt         DateTime?
}

enum ResultStatus {
  PENDING
  PARTIALLY_GRADED
  COMPLETED
}
// ========== الامتحانات ==========
model Exam {
  id                String        @id @default(cuid())
  title             String
  description       String?       @db.Text
  type              ExamType      @default(WEEKLY)
  grade             Grade         @relation(fields: [gradeId], references: [id])
  gradeId           String
  unit              Unit?         @relation(fields: [unitId], references: [id])
  unitId            String?
  durationMinutes   Int           @default(30)
  totalMarks        Float         @default(10)
  startDate         DateTime?
  endDate           DateTime?
  attemptsAllowed   Int           @default(1)
  status            ExamStatus    @default(DRAFT)
  createdBy         Teacher       @relation(fields: [teacherId], references: [id])
  teacherId         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  questions         ExamQuestion[]
  attempts          ExamAttempt[]
}

enum ExamType {
  WEEKLY
  MONTHLY
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ExamQuestion {
  id          String   @id @default(cuid())
  exam        Exam     @relation(fields: [examId], references: [id])
  examId      String
  question    Question @relation(fields: [questionId], references: [id])
  questionId  String
  order       Int

  @@unique([examId, questionId])
}

model ExamAttempt {
  id                 String            @id @default(cuid())
  student            Student           @relation(fields: [studentId], references: [id])
  studentId          String
  exam               Exam              @relation(fields: [examId], references: [id])
  examId             String
  attemptNumber      Int               @default(1)
  startedAt          DateTime          @default(now())
  submittedAt        DateTime?
  timeTakenSeconds   Int?
  status             ExamAttemptStatus @default(IN_PROGRESS)
  marksObtained      Float?
  gradedBy           Teacher?          @relation(fields: [gradedById], references: [id])
  gradedById         String?
  gradedAt           DateTime?

  // تخزين حالة الأسئلة (للـ Mark for Review) كـ JSON
  questionsState     Json? // { "questionId": "answered|unanswered|marked" }

  answers            ExamAnswer[]
  result             Result?          // النتيجة النهائية (one-to-one)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  GRADED_PARTIAL
  COMPLETED
}

model ExamAnswer {
  id            String       @id @default(cuid())
  attempt       ExamAttempt  @relation(fields: [attemptId], references: [id])
  attemptId     String
  question      Question     @relation(fields: [questionId], references: [id])
  questionId    String
  // الإجابة: نص (للمقالي) أو JSON (للخيارات)
  answerText    String?      @db.Text
  answerJson    Json?
  isCorrect     Boolean?     // للموضوعي
  marksAwarded  Float?
  reviewedBy    Teacher?     @relation(fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
}

// ========== تحديث Result ليشمل الامتحانات ==========
// يمكننا إضافة حقلين في Result أو إبقائها منفصلة، لكن الأفضل توحيدها:
// نضيف حقولاً اختيارية في Result
// أو نضيف نموذج منفصل للامتحانات، لكن التوحيد أفضل.
// سنقوم بتعديل Result لدعم الامتحانات:
// نضيف examAttemptId و examId اختياريين، ونحتفظ بـ submissionId
// لكن لتجنب التعديل على النموذج السابق، سنقوم بإنشاء Result موحد مع حقول:
// referenceType: ASSIGNMENT | EXAM
// referenceId: (إما submissionId أو examAttemptId)
// أو ببساطة نربط Result بـ ExamAttempt عبر relation اختيارية.
// سأقوم بإضافة relation جديدة في Result:

model Result {
  id               String         @id @default(cuid())
  student          Student        @relation(fields: [studentId], references: [id])
  studentId        String
  // للواجبات
  submission       Submission?    @relation(fields: [submissionId], references: [id])
  submissionId     String?        @unique
  // للامتحانات
  examAttempt      ExamAttempt?   @relation(fields: [examAttemptId], references: [id])
  examAttemptId    String?        @unique

  totalMarks       Float
  obtainedMarks    Float
  percentage       Float
  correctCount     Int
  wrongCount       Int
  unattemptedCount Int
  timeTakenSeconds Int?
  attemptNumber    Int
  status           ResultStatus   @default(PENDING)
  gradedAt         DateTime?

  // تحديد المصدر
  referenceType    String // "ASSIGNMENT" or "EXAM"

  @@unique([submissionId, examAttemptId]) // أحدهما فقط
}
